# Production Environment Template

# Copy this file to backend/.env.production and fill in actual values
# DO NOT commit this file to version control

# Server
PORT=8080

# Database
# Format: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=postgres://atelieradmin:YOUR_SECURE_PASSWORD@atelier-db.XXXX.us-east-1.rds.amazonaws.com:5432/atelier?sslmode=require

# JWT
JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE

# AWS
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_REGION=us-east-1
S3_BUCKET=atelier-uploads

# AI Services
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
REPLICATE_API_TOKEN=YOUR_REPLICATE_API_TOKEN

# Frontend URL
FRONTEND_URL=https://YOUR_DOMAIN.com
