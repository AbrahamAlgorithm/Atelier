    {
      "name": "Upload",
      "item": [
        {
          "name": "Get Presigned Upload URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('upload_url', jsonData.upload_url);",
                  "  pm.environment.set('file_url', jsonData.file_url);",
